{
  "manifest_version": 3,
  "name": "Daily Shuffle",
  "version": "1.0.0",
  "description": "Open a random historical Daily Puzzle. Independent and unaffiliated with Chess.com.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.chess.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Daily Shuffle" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{ "matches": ["https://www.chess.com/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
